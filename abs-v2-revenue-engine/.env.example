# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://abs:abs@localhost:5432/abs_v2?schema=public
REDIS_URL=redis://localhost:6379
AGENT_DISCOVERY_FEEDS=[]
DISCOVERY_INTERVAL_SECONDS=300
AGENT_AUTO_CLAIM_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ABS_ADMIN_TOKEN=replace-with-a-random-secret-at-least-16-characters
AUTHORIZATION_HMAC_SECRET=
PRODUCTION_FINANCIAL_OPERATIONS_ENABLED=false
ABS_PAYOUT_RELEASE_GATE_PASSED=false
PAYPAL_BANK_DESTINATION_VERIFIED=false
PAYPAL_AUTO_TRANSFERS_CONFIGURED=false

# x402/Base USDC agent payments: remain disabled until settlement/reconciliation gates pass.
X402_ENABLED=false
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE=$1.00
X402_LEDGER_RECONCILIATION_READY=false
