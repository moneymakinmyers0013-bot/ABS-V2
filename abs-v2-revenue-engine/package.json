{
  "name": "abs-v2-revenue-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-evidence-gated B2B task execution and payout reconciliation scaffold",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/worker.ts",
    "discovery": "tsx src/workers/discovery.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test tests/*.test.mjs",
    "sandbox:lifecycle": "tsx scripts/sandbox-lifecycle.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@vercel/analytics": "^2.0.1",
    "@x402/core": "^2.6.0",
    "@x402/evm": "^2.6.0",
    "@x402/express": "^2.6.0",
    "bullmq": "^5.58.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
